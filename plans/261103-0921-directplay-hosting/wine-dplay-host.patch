+/* Must be called with the lock held */
+HRESULT DP_MSG_BuildSuperEnumPlayersReply( IDirectPlayImpl *This, void **reply, DWORD *replySize )
+{
+  WCHAR *password;
+  WCHAR *name;
+  DWORD size;
+  HRESULT hr;
+
+  *reply = NULL;
+  *replySize = 0;
+
+  name = DP_DuplicateString( This->dp2->lpSessionDesc->lpszSessionName, FALSE,
+                             This->dp2->bAnsiSessionDesc );
+  password = DP_DuplicateString( This->dp2->lpSessionDesc->lpszPassword, FALSE,
+                                 This->dp2->bAnsiSessionDesc );
+
+  hr = DP_MSG_WriteSuperEnumPlayersReply( This, NULL, &size, name, password );
+  if( SUCCEEDED( hr ) )
+  {
+    *replySize = This->dp2->spData.dwSPHeaderSize + size;
+    *reply = calloc( 1, *replySize );
+    if( !*reply )
+    {
+      *replySize = 0;
+      hr = DPERR_OUTOFMEMORY;
+    }
+  }
+  if( SUCCEEDED( hr ) )
+    hr = DP_MSG_WriteSuperEnumPlayersReply( This,
+                                            (char *)*reply + This->dp2->spData.dwSPHeaderSize,
+                                            &size, name, password );
+  if( FAILED( hr ) )
+  {
+    free( *reply );
+    *reply = NULL;
+    *replySize = 0;
+  }
+
+  free( password );
+  free( name );
+
+  return hr;
+}
