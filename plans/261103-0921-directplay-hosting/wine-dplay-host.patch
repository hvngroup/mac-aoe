+/* Writes the name table as a DPSP_MSG_SUPERENUMPLAYERSREPLY body at msg (or only computes its
+ * size if msg is NULL). Offsets are relative to the start of the message envelope. */
+static HRESULT DP_MSG_WriteSuperEnumPlayersReply( IDirectPlayImpl *This, char *msg, DWORD *size,
+                                                  const WCHAR *name, const WCHAR *password )
+{
+  DPSP_MSG_SUPERENUMPLAYERSREPLY *reply = (DPSP_MSG_SUPERENUMPLAYERSREPLY *)msg;
+  DPSESSIONDESC2 sessionDesc;
+  struct PlayerList *plist;
+  DWORD descriptionOffset;
+  DWORD passwordOffset = 0;
+  DWORD nameOffset = 0;
+  DWORD playerCount = 0;
+  DWORD groupCount = 0;
+  DWORD packedOffset;
+  DWORD offset;
+  HRESULT hr;
+
+  offset = sizeof( DPSP_MSG_SUPERENUMPLAYERSREPLY );
+
+  sessionDesc = *This->dp2->lpSessionDesc;
+  sessionDesc.dwSize = sizeof( sessionDesc );
+  sessionDesc.lpszSessionName = NULL;
+  sessionDesc.lpszPassword = NULL;
+  descriptionOffset = offset;
+  DP_MSG_Write( msg, &offset, &sessionDesc, sizeof( sessionDesc ) );
+
+  if( name )
+  {
+    nameOffset = offset;
+    DP_MSG_WriteString( msg, &offset, name );
+  }
+  if( password && *password )
+  {
+    passwordOffset = offset;
+    DP_MSG_WriteString( msg, &offset, password );
+  }
+
+  packedOffset = offset;
+
+  for( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist;
+       plist = DPQ_NEXT( plist->players ) )
+  {
+    struct PlayerData *player = plist->lpPData;
+    DWORD spPlayerDataSize = 0;
+    void *spPlayerData = NULL;
+    DWORD versionOrSystemPlayerId;
+    DWORD flags;
+
+    if( FAILED( IDirectPlaySP_GetSPPlayerData( This->dp2->spData.lpISP, player->dpid,
+                                               &spPlayerData, &spPlayerDataSize,
+                                               DPSET_REMOTE ) ) )
+      spPlayerDataSize = 0;
+
+    flags = player->dwFlags & (DPLAYI_PLAYER_SYSPLAYER | DPLAYI_PLAYER_NAMESRVR |
+                               DPLAYI_PLAYER_PLAYERINGROUP | DPLAYI_PLAYER_PLAYERLOCAL);
+    if( flags & DPLAYI_PLAYER_SYSPLAYER )
+    {
+      flags |= DPLAYI_PLAYER_PLAYERINGROUP;
+      versionOrSystemPlayerId = DPMSGVER_DP6;
+    }
+    else
+    {
+      versionOrSystemPlayerId = player->systemPlayerId ? player->systemPlayerId
+                                                       : This->dp2->systemPlayerId;
+    }
+
+    DP_MSG_WriteSuperPackedPlayer( msg, &offset, flags, player->dpid, versionOrSystemPlayerId,
+                                   player->name, player->lpRemoteData, player->dwRemoteDataSize,
+                                   spPlayerData, spPlayerDataSize, NULL, 0, FALSE, 0 );
+    ++playerCount;
+  }
+
+  hr = DP_MSG_WriteGroups( This, msg, &offset, This->dp2->lpSysGroup, &groupCount );
+  if( FAILED( hr ) )
+    return hr;
+
+  if( reply )
+  {
+    reply->envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+    reply->envelope.wCommandId = DPMSGCMD_SUPERENUMPLAYERSREPLY;
+    reply->envelope.wVersion = DPMSGVER_DP6;
+    reply->playerCount = playerCount;
+    reply->groupCount = groupCount;
+    reply->packedOffset = packedOffset;
+    reply->shortcutCount = 0;
+    reply->descriptionOffset = descriptionOffset;
+    reply->nameOffset = nameOffset;
+    reply->passwordOffset = passwordOffset;
