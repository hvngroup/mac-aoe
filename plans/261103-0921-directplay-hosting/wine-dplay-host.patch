+static void DP_MSG_Write( char *msg, DWORD *offset, const void *data, DWORD size )
+{
+  if( msg && size )
+    memcpy( msg + *offset, data, size );
+  *offset += size;
+}
+
+static void DP_MSG_WriteString( char *msg, DWORD *offset, const WCHAR *string )
+{
+  DP_MSG_Write( msg, offset, string, (lstrlenW( string ) + 1) * sizeof( WCHAR ) );
+}
+
+/* Writes a DPLAYI_SUPERPACKEDPLAYER at msg + *offset (or only computes its size if msg is NULL).
+ * All the variable sized length fields are written with 4 bytes. */
+static void DP_MSG_WriteSuperPackedPlayer( char *msg, DWORD *offset, DWORD flags, DPID id,
+        DWORD versionOrSystemPlayerId, const DPNAME *name, const void *playerData,
+        DWORD playerDataSize, const void *spData, DWORD spDataSize, const DPID *playerIds,
+        DWORD playerCount, BOOL writePlayerCount, DPID parentId )
+{
+  DWORD start = *offset;
+  DWORD infoMask = 0;
+
+  *offset += sizeof( DPLAYI_SUPERPACKEDPLAYER );
+
+  if( name && name->lpszShortName )
+  {
+    infoMask |= DPLAYI_SUPERPACKEDPLAYER_SHORT_NAME_PRESENT;
+    DP_MSG_WriteString( msg, offset, name->lpszShortName );
+  }
+  if( name && name->lpszLongName )
+  {
+    infoMask |= DPLAYI_SUPERPACKEDPLAYER_LONG_NAME_PRESENT;
+    DP_MSG_WriteString( msg, offset, name->lpszLongName );
+  }
+  if( playerDataSize )
+  {
+    infoMask |= 3 << 4;
+    DP_MSG_Write( msg, offset, &playerDataSize, sizeof( DWORD ) );
+    DP_MSG_Write( msg, offset, playerData, playerDataSize );
+  }
+  if( spDataSize )
+  {
+    infoMask |= 3 << 2;
+    DP_MSG_Write( msg, offset, &spDataSize, sizeof( DWORD ) );
+    DP_MSG_Write( msg, offset, spData, spDataSize );
+  }
+  if( writePlayerCount )
+  {
+    infoMask |= 3 << 6;
+    DP_MSG_Write( msg, offset, &playerCount, sizeof( DWORD ) );
+    DP_MSG_Write( msg, offset, playerIds, playerCount * sizeof( DPID ) );
+  }
+  if( parentId )
+  {
+    infoMask |= DPLAYI_SUPERPACKEDPLAYER_PARENT_ID_PRESENT;
+    DP_MSG_Write( msg, offset, &parentId, sizeof( DPID ) );
+  }
+
+  if( msg )
+  {
+    DPLAYI_SUPERPACKEDPLAYER *packedPlayer = (DPLAYI_SUPERPACKEDPLAYER *)(msg + start);
+
+    packedPlayer->size = 16;
+    packedPlayer->flags = flags;
+    packedPlayer->id = id;
+    packedPlayer->infoMask = infoMask;
+    packedPlayer->versionOrSystemPlayerId = versionOrSystemPlayerId;
+  }
+}
+
+static HRESULT DP_MSG_WriteGroups( IDirectPlayImpl *This, char *msg, DWORD *offset,
+                                   struct GroupData *parent, DWORD *groupCount )
+{
+  struct GroupList *glist;
+
+  for( glist = DPQ_FIRST( parent->groups ); glist; glist = DPQ_NEXT( glist->groups ) )
+  {
+    struct GroupData *group = glist->lpGData;
+    struct PlayerList *plist;
+    DWORD playerCount = 0;
+    DPID *playerIds;
+    HRESULT hr;
+
+    for( plist = DPQ_FIRST( group->players ); plist; plist = DPQ_NEXT( plist->players ) )
+      ++playerCount;
+
+    playerIds = malloc( playerCount * sizeof( DPID ) + 1 );
+    if( !playerIds )
+      return DPERR_OUTOFMEMORY;
+    playerCount = 0;
+    for( plist = DPQ_FIRST( group->players ); plist; plist = DPQ_NEXT( plist->players ) )
+      playerIds[ playerCount++ ] = plist->lpPData->dpid;
+
+    DP_MSG_WriteSuperPackedPlayer( msg, offset, group->dwFlags & ~DPLAYI_PLAYER_PLAYERLOCAL,
+                                   group->dpid, This->dp2->systemPlayerId, group->name,
+                                   group->lpRemoteData, group->dwRemoteDataSize, NULL, 0,
+                                   playerIds, playerCount, TRUE, group->parent );
+    free( playerIds );
+    ++*groupCount;
+
+    hr = DP_MSG_WriteGroups( This, msg, offset, group, groupCount );
+    if( FAILED( hr ) )
+      return hr;
+  }
+
+  return DP_OK;
+}
