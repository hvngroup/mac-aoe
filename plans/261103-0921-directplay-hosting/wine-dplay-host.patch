+static HRESULT DPWS_StartEnumListener( DPWS_DATA *dpwsData )
+{
+    SOCKADDR_IN addr;
+
+    if ( dpwsData->enumUdpSock != INVALID_SOCKET )
+        return DP_OK;
+
+    memset( &addr, 0, sizeof( addr ) );
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl( INADDR_ANY );
+    addr.sin_port = htons( DPWS_PORT );
+
+    dpwsData->enumUdpSock = socket( AF_INET, SOCK_DGRAM, IPPROTO_UDP );
+    if ( dpwsData->enumUdpSock == INVALID_SOCKET )
+    {
+        ERR( "socket() failed\n" );
+        return DPERR_UNAVAILABLE;
+    }
+
+    if ( SOCKET_ERROR == bind( dpwsData->enumUdpSock, (SOCKADDR *)&addr, sizeof( addr ) ) )
+    {
+        ERR( "bind() to UDP port %d failed: %d\n", DPWS_PORT, WSAGetLastError() );
+        closesocket( dpwsData->enumUdpSock );
+        dpwsData->enumUdpSock = INVALID_SOCKET;
+        return DPERR_UNAVAILABLE;
+    }
+
+    /* Enumeration requests sent to a specific address may also arrive over TCP. Failing to listen
+     * there is not fatal, broadcast enumeration only needs the UDP socket. */
+    dpwsData->enumTcpSock = socket( AF_INET, SOCK_STREAM, IPPROTO_TCP );
+    if ( dpwsData->enumTcpSock != INVALID_SOCKET &&
+         ( SOCKET_ERROR == bind( dpwsData->enumTcpSock, (SOCKADDR *)&addr, sizeof( addr ) ) ||
