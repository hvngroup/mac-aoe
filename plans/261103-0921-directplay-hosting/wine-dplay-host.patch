+/* A joining machine asks the host to add its system player to the session. Add it, tell the
+ * other machines about it and answer with the name table. */
+static HRESULT DP_HandleAddForwardRequest( IDirectPlayImpl *This, void *messageBody,
+        DWORD messageBodySize, void *messageHeader, void **reply, DWORD *replySize )
+{
+  const WCHAR *requestPassword = L"";
+  DPMSG_FORWARDADDPLAYER *msg;
+  struct PlayerData *player;
+  struct PlayerList *plist;
+  DPPLAYERINFO playerInfo;
+  WCHAR *password;
+  DWORD offset;
+  HRESULT hr;
+
+  if( messageBodySize < sizeof( DPMSG_FORWARDADDPLAYER ) )
+    return DPERR_GENERIC;
+  msg = (DPMSG_FORWARDADDPLAYER *) messageBody;
+
+  offset = msg->createOffset;
+  if( offset < sizeof( DPMSG_FORWARDADDPLAYER ) || offset > messageBodySize )
+    return DPERR_GENERIC;
+
+  hr = DP_MSG_ReadPackedPlayer( (char *) messageBody, &offset, messageBodySize, &playerInfo );
+  if( FAILED( hr ) )
+    return hr;
+
+  if( msg->passwordOffset )
+  {
+    DWORD maxLength;
+
+    if( msg->passwordOffset < sizeof( DPMSG_FORWARDADDPLAYER ) ||
+        msg->passwordOffset >= messageBodySize )
+      return DPERR_GENERIC;
+    maxLength = (messageBodySize - msg->passwordOffset) / sizeof( WCHAR );
+    requestPassword = (const WCHAR *) ((char *) messageBody + msg->passwordOffset);
+    if( wcsnlen( requestPassword, maxLength ) == maxLength )
+      return DPERR_GENERIC;
+  }
+
+  EnterCriticalSection( &This->lock );
+
+  if( !This->dp2->bConnectionOpen || !This->dp2->bHostInterface )
+  {
+    LeaveCriticalSection( &This->lock );
+    return DP_OK;
+  }
+
+  TRACE( "Adding system player 0x%08lx from remote request\n", playerInfo.id );
+
+  password = DP_DuplicateString( This->dp2->lpSessionDesc->lpszPassword, FALSE,
+                                 This->dp2->bAnsiSessionDesc );
+  if( password && *password && wcscmp( password, requestPassword ) )
+  {
+    free( password );
+    LeaveCriticalSection( &This->lock );
+    return DP_MSG_BuildAddForwardReply( This, DPERR_INVALIDPASSWORD, reply, replySize );
+  }
+  free( password );
+
+  if( This->dp2->lpSessionDesc->dwFlags &
+      (DPSESSION_JOINDISABLED | DPSESSION_NEWPLAYERSDISABLED) )
+  {
+    LeaveCriticalSection( &This->lock );
+    return DP_MSG_BuildAddForwardReply( This, DPERR_CANTCREATEPLAYER, reply, replySize );
+  }
+
+  plist = DP_FindPlayer( This, playerInfo.id );
+  if( plist )
+  {
+    WARN( "Player 0x%08lx already exists\n", playerInfo.id );
+    player = plist->lpPData;
+  }
+  else
+  {
+    hr = DP_CreatePlayer( This, messageHeader, &playerInfo.id, &playerInfo.name,
+                          playerInfo.playerData, playerInfo.playerDataLength, playerInfo.spData,
+                          playerInfo.spDataLength, playerInfo.flags & ~DPLAYI_PLAYER_PLAYERLOCAL,
+                          NULL, &player, FALSE );
+    if( FAILED( hr ) )
+    {
+      LeaveCriticalSection( &This->lock );
+      return DP_MSG_BuildAddForwardReply( This, hr, reply, replySize );
+    }
+    player->systemPlayerId = playerInfo.id;
+
+    /* Let the other machines update their name tables */
+    for( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist;
+         plist = DPQ_NEXT( plist->players ) )
+    {
+      struct PlayerData *other = plist->lpPData;
+
+      if( other == player || !(other->dwFlags & DPLAYI_PLAYER_SYSPLAYER) ||
+          (other->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) )
+        continue;
+
+      hr = DP_MSG_SendAddForward( This, other->dpid, player );
+      if( FAILED( hr ) )
+        ERR( "Failed to forward player 0x%08lx to 0x%08lx: %s\n", player->dpid, other->dpid,
+             DPLAYX_HresultToString( hr ) );
+    }
+  }
+
+  hr = DP_MSG_BuildSuperEnumPlayersReply( This, reply, replySize );
+
+  LeaveCriticalSection( &This->lock );
+
+  return hr;
+}
