; cnc-ddraw settings written by aoe-mac (https://github.com/FunkyFr3sh/cnc-ddraw).
; The game keeps asking DirectDraw for low 8-bit display modes that Apple
; Silicon Macs no longer offer; cnc-ddraw draws into a normal window instead
; and scales the picture, so the real display mode never changes.

[ddraw]
; fullscreen=true together with windowed=true is borderless fullscreen (scaled).
windowed=true
fullscreen=@FULLSCREEN@
maintas=true
boxing=false
border=true
resizable=true
adjmouse=true
; GDI by default: the game's text boxes (player name, chat) are real Win32
; child windows, and Wine's macOS driver cannot composite them over an
; OpenGL surface (the screen turns white around the text box). Change with
; "aoe-mac renderer opengl|direct3d9|auto|gdi".
renderer=@RENDERER@
; Upscaling filter, only used by the opengl renderer.
shader=Bilinear
vsync=false
maxfps=-1
; Keep these settings authoritative instead of saving window state.
savesettings=0

; Per-game sections copied from cnc-ddraw's own ddraw.ini.
; Age of Empires
[empires]
nonexclusive=true
adjmouse=true
resolutions=2

; Age of Empires: The Rise of Rome
[empiresx]
nonexclusive=true
adjmouse=true
resolutions=2
